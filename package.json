{
  "name": "spicecoast-automation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "dev:server": "node server/server.js",
    "dev:ui": "vite",
    "dev": "concurrently \"node server/server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test server/test/*.test.js",
    "docker:build": "docker build -t spicecoast-leadgen .",
    "docker:run": "docker run -p 5000:10000 --env-file .env spicecoast-leadgen",
    "auth:hash": "node server/scripts/hash-password.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "nodemailer": "^10.0.10",
    "openai": "^4.85.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": "22.x || 24.x"
  }
}
