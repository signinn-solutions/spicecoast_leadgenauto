# Copy to .env and fill only the providers you use.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Single-business dashboard login. Required in production; optional on local loopback in development.
ADMIN_EMAIL=
# Generate with: npm run auth:hash (never store the plaintext password)
ADMIN_PASSWORD_HASH=
# Set to 1 only when exactly one trusted reverse proxy is in front of the API.
TRUST_PROXY=0
# Optional: override Vite's API proxy target when the API runs elsewhere.
# VITE_API_TARGET=http://127.0.0.1:5000
# Production: absolute path in Hostinger's persistent, writable directory.
# Keep the database outside the code directory replaced on redeploy.
# SPICECOAST_DB_PATH=/your/persistent/path/spicecoast.sqlite

# Hostinger Node.js Web App settings (use the platform-provided PORT):
# HOST=0.0.0.0
# NODE_ENV=production
TZ=Asia/Kolkata

# Lead discovery and enrichment
GOOGLE_API_KEY=
HUNTER_API_KEY=

# AI drafting
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Mail delivery and inbound webhook
HOSTINGER_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=
HOSTINGER_WEBHOOK_BEARER_TOKEN=
SENDER_MAILBOX=sales@thespicecoast.com
# HOSTINGER_SEND_ENDPOINT=

# Optional SMTP mail transport
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Existing automation limits
AUTO_SEND=false
DAILY_LEAD_LIMIT=100
DAILY_REPLY_LIMIT=30
