# Copy to .env and fill only the providers you use.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Legacy administrator credentials are supported until the first persistent account is created.
# Create the first super admin with npm run admin:setup -- your@email
ADMIN_EMAIL=
# Generate with: npm run auth:hash (never store the plaintext password)
ADMIN_PASSWORD_HASH=
# Set to 1 only when exactly one trusted reverse proxy is in front of the API.
TRUST_PROXY=0
# Optional: override Vite's API proxy target when the API runs elsewhere.
# VITE_API_TARGET=http://127.0.0.1:5000
# Optional SQLite database path (local default: ./spicecoast.sqlite | Render Docker persistent disk: /var/data/spicecoast.sqlite)
# SPICECOAST_DB_PATH=/var/data/spicecoast.sqlite

# Render Deployment Defaults:
# PORT=10000
# HOST=0.0.0.0
# NODE_ENV=production

# Lead discovery and enrichment
GOOGLE_API_KEY=
# Optional paid fallback and verification; website scraping works with this disabled.
HUNTER_ENABLED=false
HUNTER_API_KEY=

# AI drafting
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mail delivery and inbound webhook
HOSTINGER_MAILBOX_ID=
HOSTINGER_API_TOKEN=
HOSTINGER_WEBHOOK_BEARER_TOKEN=
SENDER_MAILBOX=sales@thespicecoast.com
# HOSTINGER_SEND_ENDPOINT=

# Optional SMTP mail transport
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Existing automation limits
AUTO_SEND=false
# -1 removes the app daily discovery cap; 0 disables discovery. Google query quotas still apply.
DAILY_LEAD_LIMIT=-1
DAILY_REPLY_LIMIT=30

# Generate once with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this outside the database and include it in your secret-manager backup.
SETTINGS_ENCRYPTION_KEY=
DAILY_SEND_LIMIT=50
QUOTA_TIMEZONE=Asia/Kolkata
