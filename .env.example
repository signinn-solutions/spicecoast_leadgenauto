# =============================================================
# SpiceCoast Lead Automation & Mailbox — Environment Configuration
# =============================================================

# Server Environment
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=*

# 1. Google Cloud Places API (for B2B lead discovery)
GOOGLE_API_KEY=your_google_places_api_key_here

# 2. Hunter.io API (for email extraction & deliverability verification)
HUNTER_API_KEY=your_hunter_api_key_here

# 3. DeepSeek API (for AI mail response drafting via OpenAI SDK)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 4. Hostinger Agentic Mail API & Webhook
HOSTINGER_API_TOKEN=your_hostinger_agentic_mail_api_token_here
HOSTINGER_WEBHOOK_BEARER_TOKEN=your_hostinger_webhook_bearer_token_here
SENDER_MAILBOX=sales@thespicecoast.com

# 5. Automation Guardrails
AUTO_SEND=false
DAILY_LEAD_LIMIT=50
DAILY_REPLY_LIMIT=30

# 6. SMTP Settings (Optional alternative/fallback for email dispatch)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=outreach@thespicecoast.com
# SMTP_PASS=your_mailbox_password_here
# SMTP_SECURE=true
