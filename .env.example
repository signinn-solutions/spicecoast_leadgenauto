# Copy to .env and fill only the providers you use.
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# Optional: override Vite's API proxy target when the API runs elsewhere.
# VITE_API_TARGET=http://127.0.0.1:5000
# Optional SQLite database path (local default: ./spicecoast.sqlite | Render Docker persistent disk: /var/data/spicecoast.sqlite)
# SPICECOAST_DB_PATH=/var/data/spicecoast.sqlite

# Render Deployment Defaults:
# PORT=10000
# HOST=0.0.0.0
# NODE_ENV=production

# Lead discovery and enrichment
GOOGLE_API_KEY=
HUNTER_API_KEY=

# AI drafting
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mail delivery and inbound webhook
HOSTINGER_API_TOKEN=
HOSTINGER_WEBHOOK_BEARER_TOKEN=
SENDER_MAILBOX=sales@thespicecoast.com
# HOSTINGER_SEND_ENDPOINT=

# Optional SMTP mail transport
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Existing automation limits
AUTO_SEND=false
DAILY_LEAD_LIMIT=50
DAILY_REPLY_LIMIT=30
